@page "/"
@using RoamingRoutes.Shared.Models.Games
@using RoamingRoutes.Client.Services
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject RoamingRoutes.Client.Services.ILocalGameService LocalGameService
@inject RoamingRoutes.Client.Services.IWordPairClientService WordPairService
@inject NavigationManager NavigationManager
@inject System.Net.Http.HttpClient Http
@inject Microsoft.JSInterop.IJSRuntime JS

@code {
    // Simple local class for game results since GameResultDTO is not in the shared models
    public class GameResultDTO
    {
        public string Winner { get; set; } = "";
        public string Reason { get; set; } = "";
    }
}

<div class="container">

    @if (gamePhase == GamePhase.Setup)
    {
        <!-- Game Setup -->
        <div class="card">
            <div class="card-header">
                <h1>🎭 Undercover</h1>
                <p class="lead">A pass-and-play word game of bluff and deduction for 3–10 players. Everyone gets a secret word — except the ones who don't.</p>
                <p class="subtle">New to the game? <a href="how-to-play" class="text-link">Read the rules</a></p>
            </div>

            <!-- Step indicator: keeps the setup form from being one long mobile scroll -->
            <div class="step-indicator">
                <div class="step-dot @(setupStep == 1 ? "active" : "done")"></div>
                <div class="step-dot @(setupStep == 2 ? "active" : "")"></div>
            </div>

            @if (setupStep == 1)
            {
            <!-- Word Category Selection -->
            <div class="form-group">
                <label class="form-label" for="category-select">Word category</label>
                @if (wordCategories.Any())
                {
                    <div class="custom-select-wrapper">
                        <select id="category-select" @bind="selectedCategoryName" class="custom-select">
                            @{
                                var englishCategories = wordCategories.Where(c => c.Language == "EN").ToList();
                                var dutchCategories = wordCategories.Where(c => c.Language == "NL").ToList();
                            }

                            @if (dutchCategories.Any())
                            {
                                <option value="🎲 Mix All Dutch Categories!">🎲 Mix All Dutch Categories!</option>
                                @foreach (var category in dutchCategories)
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            }

                            @if (englishCategories.Any())
                            {
                                <option value="🎲 Mix All English Categories!">🎲 Mix All English Categories!</option>
                                @foreach (var category in englishCategories)
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            }
                        </select>
                        <div class="select-arrow" aria-hidden="true">▼</div>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedCategoryName))
                    {
                        @if (selectedCategoryName == "🎲 Mix All English Categories!")
                        {
                            <div class="category-info mixed">
                                <p class="headline">All English categories combined for maximum variety!</p>
                                <p class="count">@wordCategories.Where(c => c.Language == "EN").Sum(c => c.Pairs.Count) word pairs available</p>
                            </div>
                        }
                        else if (selectedCategoryName == "🎲 Mix All Dutch Categories!")
                        {
                            <div class="category-info mixed">
                                <p class="headline">Alle Nederlandse categorieën gecombineerd voor maximale variatie!</p>
                                <p class="count">@wordCategories.Where(c => c.Language == "NL").Sum(c => c.Pairs.Count) woordparen beschikbaar</p>
                            </div>
                        }
                        else
                        {
                            var selectedCategory = wordCategories.FirstOrDefault(c => c.Name == selectedCategoryName);
                            @if (selectedCategory != null)
                            {
                                <div class="category-info">
                                    <p>@selectedCategory.Description</p>
                                    <p class="count">@selectedCategory.Pairs.Count word pairs available</p>
                                </div>
                            }
                        }
                    }
                }
                else
                {
                    <div class="category-info">Loading word categories…</div>
                }
            </div>

            <!-- Player Count -->
            <div class="form-group">
                <div class="slider-head">
                    <label class="form-label" for="player-count">Number of players</label>
                    <span class="slider-value">@playerCount</span>
                </div>
                <input id="player-count" type="range" min="3" max="10" @bind="playerCount" @oninput="OnPlayerCountChanged" aria-label="Number of players" />
                <div class="slider-scale" aria-hidden="true">
                    <span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span>
                </div>
            </div>

            <!-- Role Distribution -->
            <div class="form-group">
                <label class="form-label">Roles in play</label>
                <div class="role-grid">
                    <div class="role-tile">
                        <div class="role-tile-icon">
                            <img src="Civilian-icon.png" alt="" />
                            <div class="role-count civilian">@GetCurrentCivilianCount()</div>
                        </div>
                        <div class="role-tile-name">Civilians</div>
                        <div class="role-tile-desc">Same word</div>
                    </div>
                    <div class="role-tile">
                        <div class="role-tile-icon">
                            <img src="Undercover-icon.png" alt="" />
                            <div class="role-count undercover">@GetCurrentUndercoverCount()</div>
                        </div>
                        <div class="role-tile-name">Undercover</div>
                        <div class="role-tile-desc">Similar word</div>
                    </div>
                    <div class="role-tile">
                        <div class="role-tile-icon">
                            <img src="Mrwhite-icon.png" alt="" />
                            <div class="role-count mrwhite">@GetCurrentMrWhiteCount()</div>
                        </div>
                        <div class="role-tile-name">Mr. White</div>
                        <div class="role-tile-desc">No word</div>
                    </div>
                </div>

                <!-- Custom Role Configuration -->
                <div class="center mt-1">
                    <button @onclick="ToggleCustomRoles" class="btn btn-outline-secondary btn-sm @(useCustomRoles ? "is-on" : "")">
                        @(useCustomRoles ? "✓ Custom roles — tap for default" : "⚙️ Customise roles")
                    </button>
                </div>

                @if (useCustomRoles)
                {
                    <div class="stepper-panel">
                        <div class="stepper-grid">
                            <div class="stepper">
                                <label class="form-label">Undercover</label>
                                <div class="stepper-controls">
                                    <button type="button" @onclick="DecrementUndercoverCount" disabled="@(customUndercoverCount <= 0)" class="btn btn-secondary btn-step" aria-label="Fewer undercover agents">−</button>
                                    <span class="stepper-value">@customUndercoverCount</span>
                                    <button type="button" @onclick="IncrementUndercoverCount" disabled="@(customUndercoverCount >= GetMaxUndercoverCount())" class="btn btn-secondary btn-step" aria-label="More undercover agents">+</button>
                                </div>
                            </div>
                            <div class="stepper">
                                <label class="form-label">Mr. White</label>
                                <div class="stepper-controls">
                                    <button type="button" @onclick="DecrementMrWhiteCount" disabled="@(customMrWhiteCount <= 0)" class="btn btn-secondary btn-step" aria-label="Fewer Mr. White">−</button>
                                    <span class="stepper-value">@customMrWhiteCount</span>
                                    <button type="button" @onclick="IncrementMrWhiteCount" disabled="@(customMrWhiteCount >= GetMaxMrWhiteCount())" class="btn btn-secondary btn-step" aria-label="More Mr. White">+</button>
                                </div>
                            </div>
                        </div>
                        @if (!IsRoleDistributionValid())
                        {
                            <div class="form-error" role="alert">
                                ⚠️ Non-civilians can't outnumber half the players (@(playerCount / 2))
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="action-bar">
                <button @onclick="GoToPlayersStep" disabled="@(!CanProceedToPlayersStep())" class="btn btn-primary btn-lg">
                    Next: add players →
                </button>
            </div>
            }
            else
            {
            <!-- Add Players -->
            <div class="form-group">
                <label class="form-label" for="bulk-names">Add players</label>
                <p class="form-hint">One name per line, or separated by commas — add everyone in one go.</p>
                @* Razor escapes the & in a literal &#10; entity, so build the multi-line placeholder in C# instead *@
                <textarea id="bulk-names" @bind="bulkPlayerNamesInput" @bind:event="oninput" rows="3" placeholder="@("Alice\nBob\nCharlie")" class="form-control" style="resize: vertical;"></textarea>
                <button @onclick="AddBulkPlayers" disabled="@string.IsNullOrWhiteSpace(bulkPlayerNamesInput)" class="btn btn-primary btn-block mt-1">
                    Add names
                </button>
            </div>

            <!-- Quick Start Players -->
            @if (!showQuickStartPanel)
            {
                <div class="form-group">
                    <button @onclick="ShowQuickStart" class="btn btn-secondary btn-block">🎲 No names? Pick random ones</button>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label class="form-label">Suggested names</label>
                    <div class="name-grid">
                        @foreach (var name in suggestedNamesVisible.Take(playerCount - players.Count))
                        {
                            <button @onclick="() => AddSuggestedPlayer(name)" class="btn btn-secondary">
                                + @name
                            </button>
                        }
                    </div>
                    <button @onclick="GenerateDifferentNames" class="btn btn-secondary btn-sm mt-1">
                        🎲 Generate different names
                    </button>
                </div>
            }

            <!-- Current Players -->
            @if (players.Any())
            {
                <div class="form-group">
                    <label class="form-label">Players (@players.Count / @playerCount)</label>
                    <div class="player-list">
                        @foreach (var player in players)
                        {
                            <div class="player-chip">
                                <span class="player-identity">
                                    @if (quickStartAddedPlayerIds.Contains(player.Id))
                                    {
                                        <span class="quick-start-tag" title="Added by Quick Start">🎲</span>
                                    }
                                    <span class="player-name">@player.Name</span>
                                </span>
                                <button @onclick="() => RemovePlayer(player)" class="btn btn-danger btn-sm" aria-label="Remove @player.Name">Remove</button>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Start Game -->
            <div class="action-bar">
                <button @onclick="BackToSetupStep" class="btn btn-secondary btn-lg btn-back" aria-label="Back to game options">←</button>
                <button @onclick="StartGame" disabled="@(!CanStartGame())" class="btn btn-primary btn-lg">
                    @if (gameState?.Status == GameStatus.InProgress)
                    {
                        <span>Starting…</span>
                    }
                    else
                    {
                        <span>Start game (@players.Count)</span>
                    }
                </button>
            </div>
            }
        </div>
    }
    else if (gamePhase == GamePhase.RoleAssignment)
    {
        <!-- Role Assignment Phase -->
        <div class="card">
            <div class="card-header">
                <p class="eyebrow">Pass the device</p>
                <h1>@((activeRoundPlayers.Count > currentCardIndex) ? activeRoundPlayers[currentCardIndex].Name : "Player")'s turn</h1>
                <p class="subtle">Pick a card — make sure nobody else is looking.</p>
            </div>

            <!-- Available Cards -->
            <div class="form-group">
                <label class="form-label">Choose your card (@availableCards.Count left)</label>
                <div class="card-grid">
                    @for (int i = 0; i < availableCards.Count; i++)
                    {
                        var cardIndex = i;
                        <button type="button" @onclick="() => PickCard(cardIndex)"
                                class="game-card"
                                aria-label="Pick card @(cardIndex + 1)">
                            <span aria-hidden="true">🃏</span>
                        </button>
                    }
                </div>
            </div>

            <div class="note note-center">Tap a card to see your secret role and word.</div>
        </div>
    }
    else if (gamePhase == GamePhase.RoleRevealed)
    {
        <!-- Role Revealed -->
        <div class="card">
            @if (!hasRevealedRole)
            {
                <div class="card-header">
                    <p class="eyebrow">Card picked</p>
                    <h1>Keep it to yourself</h1>
                    <p class="subtle">Make sure no one else can see the screen, then tap the card.</p>
                </div>
                <button type="button" class="reveal-gate" @onclick="RevealRole">
                    <span class="reveal-icon" aria-hidden="true">🔒</span>
                    <span>Tap to reveal your role or word</span>
                </button>
            }
            else
            {
                <div class="card-header">
                    @if (currentPlayerRole == GameConstants.PlayerRoles.MrWhite)
                    {
                        <p class="eyebrow">Your role</p>
                        <h1>You are Mr. White</h1>
                    }
                    else
                    {
                        <p class="eyebrow">Your secret</p>
                        <h1>🔍 Remember this word</h1>
                    }
                </div>

                <!-- Word Display -->
                @if (currentPlayerRole != null)
                {
                    @if (currentPlayerRole == GameConstants.PlayerRoles.Civilian)
                    {
                        <div class="word-display">
                            <div class="word-category">Your word</div>
                            <div class="word-text">@currentGameWordPair?.Civilian</div>
                        </div>
                    }
                    else if (currentPlayerRole == GameConstants.PlayerRoles.Undercover)
                    {
                        <div class="word-display">
                            <div class="word-category">Your word</div>
                            <div class="word-text">@currentGameWordPair?.Undercover</div>
                        </div>
                    }
                    else if (currentPlayerRole == GameConstants.PlayerRoles.MrWhite)
                    {
                        <div class="word-display is-mrwhite">
                            <div class="word-category">No word for you</div>
                            <div class="word-text">Blend in.</div>
                        </div>
                    }
                }

                <!-- Continue Button -->
                <div class="action-bar">
                    <button @onclick="ContinueToNextPlayer" class="btn btn-primary btn-lg">
                        @if (currentCardIndex < (activeRoundPlayers.Count - 1))
                        {
                            <span>Pass to next player →</span>
                        }
                        else
                        {
                            <span>Start word sharing →</span>
                        }
                    </button>
                </div>
            }
        </div>
    }
    else if (gamePhase == GamePhase.Discussion)
    {
        <!-- Word Sharing Phase -->
        <div class="card">
            <div class="card-header">
                <p class="eyebrow">Round in play</p>
                <h1>🔄 Word sharing</h1>
                <p class="subtle">Each player says one word linked to their card, in the order below.</p>
            </div>

            <div class="status-pill">👥 @(players.Count(p => p.IsActive)) of @(players.Count) players left</div>

            @if (discussionSecondsLeft.HasValue)
            {
                <div class="timer">
                    <div>
                        <div class="timer-value">@FormatTime(discussionSecondsLeft.Value)</div>
                        <div class="timer-label">Suggested time — take longer if you need it</div>
                    </div>
                </div>
            }

            <!-- Players List in Speaking Order (fixed once when this phase starts, so it can't silently reshuffle) -->
            <div class="form-group">
                <label class="form-label">Speaking order</label>
                <div class="player-list">
                    @for (int i = 0; i < speakingOrder.Count; i++)
                    {
                        var index = i;
                        <div class="player-chip">
                            <span class="player-identity">
                                <span class="player-order">@(index + 1)</span>
                                <span class="player-name">@speakingOrder[index].Name</span>
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Manual Progress -->
            <div class="action-bar">
                <button @onclick="StartVoting" class="btn btn-primary btn-lg">
                    Everyone spoke — start voting
                </button>
            </div>
        </div>
    }
    else if (gamePhase == GamePhase.Voting)
    {
        <!-- Voting & Discussion Phase -->
        <div class="card">
            <div class="card-header">
                <p class="eyebrow">Decide together</p>
                <h1>🗳️ Voting</h1>
                <p class="subtle">Discuss who the Undercover or Mr. White is, then tap the group's choice.</p>
            </div>

            <div class="status-pill">👥 @(players.Count(p => p.IsActive)) of @(players.Count) players left</div>

            <!-- Vote Cards -->
            <div class="vote-grid">
                @foreach (var player in players.Where(p => p.IsActive))
                {
                    <button type="button" class="vote-card @(selectedVoteTarget == player.Id ? "selected" : "")"
                            aria-pressed="@(selectedVoteTarget == player.Id)"
                            @onclick="() => SelectVoteTarget(player.Id)">
                        <div class="vote-name">@player.Name</div>
                        <div class="vote-hint">@(selectedVoteTarget == player.Id ? "✓ Selected" : "Tap to select")</div>
                    </button>
                }
            </div>

            <!-- Submit Vote -->
            <div class="action-bar">
                <button @onclick="SubmitVote" disabled="@(selectedVoteTarget == null)" class="btn btn-primary btn-lg">
                    Vote out
                </button>
            </div>
        </div>
    }
    else if (gamePhase == GamePhase.MrWhiteGuess)
    {
        <!-- Mr. White Guess Phase -->
        <div class="card">
            <div class="card-header">
                <p class="eyebrow">Last chance</p>
                <h1>❓ Mr. White's guess</h1>
                <p class="subtle">@votedOutMrWhite?.Name was voted out — but can they name the civilian word?</p>
            </div>

            <div class="status-pill">👥 @(players.Count(p => p.IsActive)) of @(players.Count) players left</div>

            <div class="note note-center accent">
                <strong>Pass the device to @votedOutMrWhite?.Name.</strong><br />
                Guess right and you win the round outright — worth 3 points.
            </div>

            <!-- Guess Input -->
            <div class="form-group mt-1">
                <label class="form-label" for="mrwhite-guess">What is the civilian word?</label>
                <input id="mrwhite-guess" @bind="mrWhiteGuess" @onkeypress="OnMrWhiteGuessKeyPress" placeholder="Type your guess…" class="form-control" autocomplete="off" />
            </div>

            <div class="action-bar">
                <button @onclick="SubmitMrWhiteGuess" disabled="@string.IsNullOrWhiteSpace(mrWhiteGuess)" class="btn btn-primary btn-lg">
                    Submit guess
                </button>
            </div>
        </div>
    }
    else if (gamePhase == GamePhase.MrWhiteEliminated)
    {
        <!-- Mr. White Eliminated Phase -->
        <div class="card">
            <div class="card-header">
                <p class="eyebrow">Wrong guess</p>
                <h1>❌ Mr. White is out</h1>
            </div>

            <div class="status-pill">👥 @(players.Count(p => p.IsActive)) of @(players.Count) players left</div>

            <!-- Elimination Info -->
            <div class="outcome">
                <span class="outcome-emoji" aria-hidden="true">💀</span>
                <div class="outcome-title lose">Not the word!</div>
                <p class="outcome-sub"><strong>@votedOutMrWhite?.Name</strong> guessed “@mrWhiteGuess” and is eliminated for this round.</p>
            </div>

            <!-- Continue Button -->
            <div class="action-bar">
                @if (players.Count <= 2)
                {
                    <button @onclick="() => gamePhase = GamePhase.Results" class="btn btn-primary btn-lg">
                        View final results
                    </button>
                }
                else
                {
                    <button @onclick="StartNewWordRound" class="btn btn-primary btn-lg">
                        Continue with a new word
                    </button>
                }
            </div>

            <!-- Host override: the typed guess didn't match exactly (typo, accent, plural, etc.)
                 but the group agrees it was actually correct - let the host award the win manually
                 instead of forcing a re-vote. -->
            <div class="note note-center mt-1">
                Was “@mrWhiteGuess” actually correct? (typo, spelling, etc.)
            </div>
            <div class="action-bar">
                <button @onclick="OverrideMrWhiteCorrectGuess" class="btn btn-outline-secondary btn-sm">
                    ✅ Host override: count it as correct
                </button>
            </div>
        </div>
    }
    else if (gamePhase == GamePhase.PlayerEliminated)
    {
        <!-- Generic Player Eliminated Reveal Phase -->
        <div class="card">
            <div class="card-header">
                <p class="eyebrow">Voted out</p>
                <h1>❌ @eliminatedPlayer?.Name is out</h1>
            </div>

            <div class="status-pill">👥 @(players.Count(p => p.IsActive)) of @(players.Count) players left</div>

            <div class="outcome">
                @if (eliminatedPlayer != null)
                {
                    @if (eliminatedPlayer.Role == GameConstants.PlayerRoles.Civilian)
                    {
                        <img src="Civilian-icon.png" alt="Civilian" class="outcome-icon" />
                    }
                    else if (eliminatedPlayer.Role == GameConstants.PlayerRoles.Undercover)
                    {
                        <img src="Undercover-icon.png" alt="Undercover" class="outcome-icon" />
                    }
                    else if (eliminatedPlayer.Role == GameConstants.PlayerRoles.MrWhite)
                    {
                        <img src="Mrwhite-icon.png" alt="Mr. White" class="outcome-icon" />
                    }
                    else
                    {
                        <span class="outcome-emoji" aria-hidden="true">🃏</span>
                    }
                }
                <div class="outcome-title win">@GetRoleDisplayName(eliminatedPlayer?.Role ?? "")</div>
                <p class="outcome-sub">They're out for the rest of this game.</p>
            </div>

            <div class="action-bar">
                <button @onclick="ContinueAfterPlayerElimination" class="btn btn-primary btn-lg">Continue</button>
            </div>
        </div>
    }
    else if (gamePhase == GamePhase.Results)
    {
        <!-- Results Phase -->
        <div class="card">
            <div class="card-header">
                <p class="eyebrow">Round over</p>
                <h1>🏆 Results</h1>
            </div>

            <!-- Winner Display -->
            @if (gameResult != null)
            {
                <div class="outcome">
                    @if (gameResult.Winner == "Civilians")
                    {
                        <img src="Civilian-icon.png" alt="Civilians win" class="outcome-icon" />
                    }
                    else if (gameResult.Winner == "Undercover")
                    {
                        <img src="Undercover-icon.png" alt="Undercover wins" class="outcome-icon" />
                    }
                    else if (gameResult.Winner == "Mr. White")
                    {
                        <img src="Mrwhite-icon.png" alt="Mr. White wins" class="outcome-icon" />
                    }
                    else
                    {
                        <span class="outcome-emoji" aria-hidden="true">❓</span>
                    }
                    <div class="outcome-title win">@gameResult.Winner Wins!</div>
                    <p class="outcome-sub">@gameResult.Reason</p>
                </div>

                <!-- Word Reveal -->
                @if (currentGameWordPair != null)
                {
                    <div class="phase-indicator">
                        <div class="phase-title">The words were</div>
                        <div class="word-pair-grid">
                            <div class="word-pair-cell">
                                <div class="word-pair-label civilian">Civilian</div>
                                <div class="word-pair-value">@currentGameWordPair.Civilian</div>
                            </div>
                            <div class="word-pair-cell">
                                <div class="word-pair-label undercover">Undercover</div>
                                <div class="word-pair-value">@currentGameWordPair.Undercover</div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Player Roles Revealed -->
                <div class="form-group">
                    <label class="form-label">Roles &amp; scores</label>
                    <div class="player-list">
                        @foreach (var player in players.OrderByDescending(p => p.Score))
                        {
                            <div class="player-chip">
                                <span class="player-identity">
                                    @if (player.Role == GameConstants.PlayerRoles.Civilian)
                                    {
                                        <img src="Civilian-icon.png" alt="" />
                                    }
                                    else if (player.Role == GameConstants.PlayerRoles.Undercover)
                                    {
                                        <img src="Undercover-icon.png" alt="" />
                                    }
                                    else if (player.Role == GameConstants.PlayerRoles.MrWhite)
                                    {
                                        <img src="Mrwhite-icon.png" alt="" />
                                    }
                                    <span class="player-name">@player.Name</span>
                                </span>
                                <span class="player-meta">
                                    <span class="role-badge role-@player.Role.ToLower()">
                                        @GetRoleDisplayName(player.Role)
                                    </span>
                                    <span class="score-badge">@player.Score pts</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Roles for next round: lets the host rebalance (e.g. add an Undercover) without
                 restarting the game and losing players/scores. Reuses the same
                 useCustomRoles/customUndercoverCount/customMrWhiteCount state that
                 SetupRoleAssignment reads when NextRound() runs. -->
            <div class="form-group">
                <div class="center">
                    <button @onclick="ToggleCustomRoles" class="btn btn-outline-secondary btn-sm @(useCustomRoles ? "is-on" : "")">
                        @(useCustomRoles ? "✓ Custom roles for next round — tap for default" : "⚙️ Change role distribution for next round")
                    </button>
                </div>

                @if (useCustomRoles)
                {
                    <div class="role-grid mt-1">
                        <div class="role-tile">
                            <div class="role-tile-icon">
                                <img src="Civilian-icon.png" alt="" />
                                <div class="role-count civilian">@GetCurrentCivilianCount()</div>
                            </div>
                            <div class="role-tile-name">Civilians</div>
                        </div>
                        <div class="role-tile">
                            <div class="role-tile-icon">
                                <img src="Undercover-icon.png" alt="" />
                                <div class="role-count undercover">@GetCurrentUndercoverCount()</div>
                            </div>
                            <div class="role-tile-name">Undercover</div>
                        </div>
                        <div class="role-tile">
                            <div class="role-tile-icon">
                                <img src="Mrwhite-icon.png" alt="" />
                                <div class="role-count mrwhite">@GetCurrentMrWhiteCount()</div>
                            </div>
                            <div class="role-tile-name">Mr. White</div>
                        </div>
                    </div>

                    <div class="stepper-panel">
                        <div class="stepper-grid">
                            <div class="stepper">
                                <label class="form-label">Undercover</label>
                                <div class="stepper-controls">
                                    <button type="button" @onclick="DecrementUndercoverCount" disabled="@(customUndercoverCount <= 0)" class="btn btn-secondary btn-step" aria-label="Fewer undercover agents">−</button>
                                    <span class="stepper-value">@customUndercoverCount</span>
                                    <button type="button" @onclick="IncrementUndercoverCount" disabled="@(customUndercoverCount >= GetMaxUndercoverCount())" class="btn btn-secondary btn-step" aria-label="More undercover agents">+</button>
                                </div>
                            </div>
                            <div class="stepper">
                                <label class="form-label">Mr. White</label>
                                <div class="stepper-controls">
                                    <button type="button" @onclick="DecrementMrWhiteCount" disabled="@(customMrWhiteCount <= 0)" class="btn btn-secondary btn-step" aria-label="Fewer Mr. White">−</button>
                                    <span class="stepper-value">@customMrWhiteCount</span>
                                    <button type="button" @onclick="IncrementMrWhiteCount" disabled="@(customMrWhiteCount >= GetMaxMrWhiteCount())" class="btn btn-secondary btn-step" aria-label="More Mr. White">+</button>
                                </div>
                            </div>
                        </div>
                        @if (!IsRoleDistributionValid())
                        {
                            <div class="form-error" role="alert">
                                ⚠️ Non-civilians can't outnumber half the players (@(playerCount / 2))
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Game Actions -->
            <p class="action-note">Next round keeps the players and scores • New game starts fresh</p>
            <div class="action-bar">
                <button @onclick="ConfirmResetGame" class="btn btn-secondary btn-lg">
                    🔄 New game
                </button>
                <button @onclick="NextRound" disabled="@(!IsRoleDistributionValid())" class="btn btn-primary btn-lg">
                    🎲 Next round
                </button>
            </div>
        </div>
    }

    <!-- Small links: how-to and feedback -->
    <div class="footer-links">
        <a href="how-to-play">How to play</a>
        <a href="https://github.com/ArdonToonstra/undercover-game/issues" target="_blank" rel="noopener noreferrer">
            Feedback / report an issue
        </a>
        @if (!string.IsNullOrWhiteSpace(publishedVersion))
        {
            <div class="footer-version">Version @publishedVersion</div>
        }
    </div>
</div>

@code {
    // Game state
    private GamePhase gamePhase = GamePhase.Setup;
    private GameStateDTO? gameState;
    private GameResultDTO? gameResult;
    private List<GamePlayer> players = new();
    private string bulkPlayerNamesInput = "";
    private int playerCount = 5;
    // When true, the initial role assignment will follow the players[] insertion order
    private bool isFirstRound = true;
    
    // Custom role configuration
    private int customUndercoverCount = 1;
    private int customMrWhiteCount = 1;
    private bool useCustomRoles = false;
    
    // Language and word categories
    private List<WordPairCategory> wordCategories = new();
    private string selectedCategoryName = "";
    
    // Role assignment
    private List<(string Role, WordPair? WordPair)> availableCards = new();
    private int currentCardIndex = 0;
    private string? currentPlayerRole;
    private WordPair? currentGameWordPair;
    // Gate that hides the freshly-picked role/word until the current player deliberately taps to reveal it
    private bool hasRevealedRole = false;

    // Setup wizard: 1 = category/players/roles, 2 = add players & start
    private int setupStep = 1;

    // Discussion & Voting
    private string? selectedVoteTarget;
    // Speaking order is computed once per Discussion phase entry (not on every render) so it can't silently reshuffle
    private List<GamePlayer> speakingOrder = new();
    private int? discussionSecondsLeft;
    private System.Timers.Timer? _discussionTimer;
    
    // Mr. White guess
    private GamePlayer? votedOutMrWhite;
    private string mrWhiteGuess = "";
    // Generic eliminated player (non-Mr White) for reveal phase
    private GamePlayer? eliminatedPlayer;
    
    // Suggested players
    private List<string> suggestedNames = new();
    // Quick-start panel state: show compact button or visible suggested names
    private bool showQuickStartPanel = false;
    private List<string> suggestedNamesVisible = new();
    // Track players added by quick-start so they can be replaced when regenerating
    private List<string> quickStartAddedPlayerIds = new();
    
    // Local player class with role
    public class GamePlayer
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public int Score { get; set; } = 0;
    // Whether the player is currently active in the ongoing round/game
    public bool IsActive { get; set; } = true;
    }
    
    private enum GamePhase
    {
        Setup,
        RoleAssignment,
        RoleRevealed,
        Discussion,
        Voting,
        MrWhiteGuess,
        MrWhiteEliminated,
        PlayerEliminated,
        Results
    }

    private string publishedVersion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPublishedVersionAsync();
        await LoadWordCategories();
        GenerateSuggestedNames();
    }

    private async Task LoadWordCategories()
    {
        try
        {
            wordCategories = await WordPairService.GetCategoriesAsync();
            if (wordCategories.Any())
                    {
                        // Prefer Dutch mixed category first if present, otherwise default to English mix
                        selectedCategoryName = wordCategories.Any(c => c.Language == "NL") ? "🎲 Mix All Dutch Categories!" : "🎲 Mix All English Categories!";
                    }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading word categories: {ex.Message}");
        }
    }

    private void GenerateSuggestedNames()
    {
        var allNames = new List<string>
        {
            "SneakyPanda", "NinjaTaco", "CosmicBurrito", "CaptainChaos", "MysteryMuffin", "ShadowPickle",
            "WizardWaffle", "StealthySpoon", "RogueRabbit", "SecretSauce", "PhantomPizza", "CloakedCookie",
            "SpySquirrel", "HiddenHamster", "DeceptiveDuck", "TrickyTurtle", "SlySalmon", "CraftyCarrot",
            "SneakySnail", "CleverCactus", "WilyWombat", "DeviantDonut", "MischievousMango", "CunningCupcake",
            "ArtfulAvocado", "SubtleSandwich", "ElusiveEggplant", "FoxyFalafel", "GuiltyGrape", "LurkerLemon",
            "BanditBagel", "RascalRadish", "VagabondVegetable", "OutlawOnion", "RebelRice", "PiratePickle",
            "ThiefTaco", "MarauderMuffin", "ScoundrelSoup", "VillainVanilla", "RogueRamen", "TricksterTofu", 
            "CunningCucumber", "SlySpinach", "WilyWatermelon", "DeceptiveDoughnut", "CraftyCabbage", "SneakySushi"
        };

        var random = new Random();
        suggestedNames = allNames.OrderBy(x => random.Next()).Take(12).ToList();
        // If the quick-start panel is visible, refresh the visible set
        if (showQuickStartPanel)
        {
            FillSuggestedNamesVisible();
        }
    }

    private void ShowQuickStart()
    {
        // Ensure we have suggested names
        if (!suggestedNames.Any()) GenerateSuggestedNames();

        // Add suggested names automatically to fill remaining slots and track added players
        var slots = Math.Max(0, playerCount - players.Count);
        quickStartAddedPlayerIds.Clear();
        for (int i = 0; i < slots; i++)
        {
            if (i >= suggestedNames.Count) break;
            var name = suggestedNames[i];
            // Add directly and track the new player's id
            if (CanAddPlayer() && !players.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
            {
                var newPlayer = new GamePlayer { Id = Guid.NewGuid().ToString(), Name = name };
                players.Add(newPlayer);
                quickStartAddedPlayerIds.Add(newPlayer.Id);
            }
        }

        // Remove the names we just used from the suggestions so they don't reappear
        suggestedNames = suggestedNames.Skip(Math.Min(suggestedNames.Count, slots)).ToList();

        showQuickStartPanel = true;
        StateHasChanged();
    }

    private void FillSuggestedNamesVisible()
    {
        var slots = Math.Max(0, playerCount - players.Count);
        suggestedNamesVisible = suggestedNames.Take(Math.Max(0, slots)).ToList();
        StateHasChanged();
    }

    private void GenerateDifferentNames()
    {
        // Remove players that were added by quick-start
        if (quickStartAddedPlayerIds.Any())
        {
            players.RemoveAll(p => quickStartAddedPlayerIds.Contains(p.Id));
            quickStartAddedPlayerIds.Clear();
        }

        // Regenerate suggested names and auto-fill again
        GenerateSuggestedNames();
        var slots = Math.Max(0, playerCount - players.Count);
        for (int i = 0; i < slots; i++)
        {
            if (i >= suggestedNames.Count) break;
            var name = suggestedNames[i];
            if (CanAddPlayer() && !players.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
            {
                var newPlayer = new GamePlayer { Id = Guid.NewGuid().ToString(), Name = name };
                players.Add(newPlayer);
                quickStartAddedPlayerIds.Add(newPlayer.Id);
            }
        }

        // Remove used names from suggestedNames
        suggestedNames = suggestedNames.Skip(Math.Min(suggestedNames.Count, slots)).ToList();

        StateHasChanged();
    }

    private async Task LoadPublishedVersionAsync()
    {
        try
        {
            var versionUri = new Uri(new Uri(NavigationManager.BaseUri), "version.txt");
            var txt = await Http.GetStringAsync(versionUri);
            publishedVersion = txt?.Trim() ?? string.Empty;
        }
        catch
        {
            // ignore errors - version is optional
            publishedVersion = string.Empty;
        }
    }

    private void ToggleCustomRoles()
    {
        useCustomRoles = !useCustomRoles;
        StateHasChanged();
    }

    private async Task OnPlayerCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int count))
        {
            playerCount = count;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AddSuggestedPlayer(string name)
    {
        if (CanAddPlayer() && !players.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            players.Add(new GamePlayer { Id = Guid.NewGuid().ToString(), Name = name });
            suggestedNames.Remove(name); // Remove from suggestions once added
            StateHasChanged();
        }
    }

    // Parses one or more names at once (newline- or comma-separated) - the fast path for
    // entering a whole group's names on a phone instead of tapping "Add" per player.
    private async Task AddBulkPlayers()
    {
        if (string.IsNullOrWhiteSpace(bulkPlayerNamesInput)) return;

        var names = bulkPlayerNamesInput
            .Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(n => n.Trim())
            .Where(n => !string.IsNullOrWhiteSpace(n));

        foreach (var name in names)
        {
            if (!CanAddPlayer()) break;
            if (!players.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
            {
                players.Add(new GamePlayer { Id = Guid.NewGuid().ToString(), Name = name });
            }
        }

        bulkPlayerNamesInput = "";
        await InvokeAsync(StateHasChanged);
    }

    private void RemovePlayer(GamePlayer player)
    {
        players.Remove(player);
        StateHasChanged();
    }

    private bool CanAddPlayer()
    {
        return players.Count < playerCount;
    }

    private bool CanStartGame()
    {
        return players.Count >= 3 && 
               players.Count == playerCount && 
               !string.IsNullOrEmpty(selectedCategoryName) &&
               IsRoleDistributionValid();
    }

    private async Task StartGame()
    {
        try
        {
            WordPairCategory selectedCategory;
            
            if (selectedCategoryName == "🎲 Mix All English Categories!")
            {
                // Create a combined category with all English word pairs
                var englishCategories = wordCategories.Where(c => c.Language == "EN").ToList();
                selectedCategory = new WordPairCategory
                {
                    Name = "🎲 Mix All English Categories!",
                    Description = "All English categories combined for maximum variety!",
                    Language = "EN",
                    Pairs = englishCategories.SelectMany(c => c.Pairs).ToList()
                };
            }
            else if (selectedCategoryName == "🎲 Mix All Dutch Categories!")
            {
                // Create a combined category with all Dutch word pairs
                var dutchCategories = wordCategories.Where(c => c.Language == "NL").ToList();
                selectedCategory = new WordPairCategory
                {
                    Name = "🎲 Mix All Dutch Categories!",
                    Description = "Alle Nederlandse categorieën gecombineerd voor maximale variatie!",
                    Language = "NL",
                    Pairs = dutchCategories.SelectMany(c => c.Pairs).ToList()
                };
            }
            else
            {
                var category = wordCategories.FirstOrDefault(c => c.Name == selectedCategoryName);
                if (category == null) return;
                selectedCategory = category;
            }

            // Create game through LocalGameService
            var createGameDto = new CreateGameRequestDTO
            {
                HostNickname = players.FirstOrDefault()?.Name ?? "Host",
                GameType = "Undercover"
            };

            gameState = await LocalGameService.CreateGameAsync(createGameDto);

            // Guard: CreateGameAsync may return null in error scenarios
            if (gameState == null)
            {
                Console.WriteLine("Failed to create game (CreateGameAsync returned null).");
                return;
            }

            // Add players to the game (all current players)
            foreach (var player in players.Skip(1)) // Skip the first player as they're already the host
            {
                await LocalGameService.JoinGameAsync(gameState.GameId, new JoinGameRequestDTO { Nickname = player.Name });
            }

            // Start the game
            await LocalGameService.StartGameAsync(gameState.GameId);

            // Get updated game state
            gameState = await LocalGameService.GetGameStateAsync(gameState.GameId);
            
            // Ensure the first role assignment preserves the player add order
            isFirstRound = true;
            // Set up role assignment
            SetupRoleAssignment(selectedCategory);
            gamePhase = GamePhase.RoleAssignment;
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting game: {ex.Message}");
        }
    }

    private void SetupRoleAssignment(WordPairCategory category)
    {
        var random = new Random();
        var selectedPair = category.Pairs[random.Next(category.Pairs.Count)];
        currentGameWordPair = selectedPair;

        // Create role distribution based on CURRENT number of players
        // Only count active players for role distribution
        var currentPlayerCount = players.Count(p => p.IsActive);
        var roles = new List<string>();
        
        // Determine role counts based on custom or default settings
        int civilianCount, undercoverCount, mrWhiteCount;
        
        if (useCustomRoles)
        {
            undercoverCount = customUndercoverCount;
            mrWhiteCount = customMrWhiteCount;
            civilianCount = currentPlayerCount - undercoverCount - mrWhiteCount;
        }
        else
        {
            civilianCount = GetCivilianCountForPlayerCount(currentPlayerCount);
            undercoverCount = GetUndercoverCountForPlayerCount(currentPlayerCount);
            mrWhiteCount = GetMisterWhiteCountForPlayerCount(currentPlayerCount);
        }
        
        // Add civilians
        for (int i = 0; i < civilianCount; i++)
        {
            roles.Add(GameConstants.PlayerRoles.Civilian);
        }
        
        // Add undercover
        for (int i = 0; i < undercoverCount; i++)
        {
            roles.Add(GameConstants.PlayerRoles.Undercover);
        }
        
        // Add Mr. White
        for (int i = 0; i < mrWhiteCount; i++)
        {
            roles.Add(GameConstants.PlayerRoles.MrWhite);
        }

        // Shuffle roles
        roles = roles.OrderBy(x => random.Next()).ToList();

        // Create available cards (capture currentGameWordPair as nullable)
        // Create available cards only for active players
        availableCards = roles.Select(role => (role, (WordPair?)currentGameWordPair)).ToList();
        
        // Build the active round players list (players who are marked IsActive)
        // For the very first round preserve the player addition order. Subsequent rounds are randomized.
        if (isFirstRound)
        {
            activeRoundPlayers = players.Where(p => p.IsActive).ToList();
            // Only preserve order for the first assignment
            isFirstRound = false;
        }
        else
        {
            activeRoundPlayers = players.Where(p => p.IsActive).OrderBy(_ => random.Next()).ToList();
        }

        // Ensure availableCards matches number of active players
        if (availableCards.Count > activeRoundPlayers.Count)
        {
            availableCards = availableCards.Take(activeRoundPlayers.Count).ToList();
        }

        currentCardIndex = 0;
    }

    private async Task PickCard(int cardIndex)
    {
        if (cardIndex >= 0 && cardIndex < availableCards.Count)
        {
            var selectedCard = availableCards[cardIndex];
            currentPlayerRole = selectedCard.Role;
            
            // Assign role to current active round player
            activeRoundPlayers[currentCardIndex].Role = selectedCard.Role;
            
            // Remove the selected card
            availableCards.RemoveAt(cardIndex);

            hasRevealedRole = false;
            gamePhase = GamePhase.RoleRevealed;
            await InvokeAsync(StateHasChanged);
        }
    }

    // The current player deliberately taps to reveal their role/word, instead of it
    // appearing the instant a card is picked (reduces the chance of it being glimpsed
    // while the device is still being handled/passed).
    private async Task RevealRole()
    {
        hasRevealedRole = true;
        await VibrateAsync(30);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ContinueToNextPlayer()
    {
        currentCardIndex++;

    if (currentCardIndex >= activeRoundPlayers.Count)
        {
            // All players have picked cards, start discussion
            EnterDiscussionPhase();
        }
        else
        {
            // Next player's turn
            gamePhase = GamePhase.RoleAssignment;
            currentPlayerRole = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    // Speaking order (and the discussion timer) are fixed once, here, rather than being
    // recomputed on every render of the Discussion view - otherwise Mr. White's position
    // could silently change if the page re-rendered for any reason.
    private void EnterDiscussionPhase()
    {
        speakingOrder = GetSpeakingOrder();
        gamePhase = GamePhase.Discussion;
        StartDiscussionTimer();
    }

    private void StartDiscussionTimer()
    {
        StopDiscussionTimer();
        discussionSecondsLeft = GameConstants.GameConfig.DiscussionTimeSeconds;
        _discussionTimer = new System.Timers.Timer(1000);
        _discussionTimer.AutoReset = true;
        _discussionTimer.Elapsed += (s, e) =>
        {
            InvokeAsync(() =>
            {
                if (discussionSecondsLeft is > 0)
                {
                    discussionSecondsLeft--;
                }
                else
                {
                    StopDiscussionTimer();
                }
                StateHasChanged();
            });
        };
        _discussionTimer.Start();
    }

    private void StopDiscussionTimer()
    {
        _discussionTimer?.Stop();
        _discussionTimer?.Dispose();
        _discussionTimer = null;
    }

    // Best-effort haptic feedback; the Vibration API is unsupported on some browsers
    // (notably iOS Safari) where it silently no-ops rather than throwing, but we guard anyway.
    private async Task VibrateAsync(int milliseconds)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.vibrate", milliseconds);
        }
        catch
        {
            // ignore - haptics are a nice-to-have, never block gameplay on them
        }
    }

    private List<GamePlayer> GetSpeakingOrder()
    {
        // Ensure Mr. White is not always last, but also never first.
        // Strategy:
        // - Shuffle non-MrWhite players
        // - Shuffle MrWhite players
        // - Insert MrWhite players at random positions in the non-MrWhite list
        //   with the constraint that no MrWhite may occupy index 0.
        var random = new Random();
    // Use only active players for the speaking order
    var activePlayers = players.Where(p => p.IsActive).ToList();
    var nonMrWhitePlayers = activePlayers.Where(p => p.Role != GameConstants.PlayerRoles.MrWhite)
                       .OrderBy(_ => random.Next())
                       .ToList();
    var mrWhitePlayers = activePlayers.Where(p => p.Role == GameConstants.PlayerRoles.MrWhite)
                     .OrderBy(_ => random.Next())
                     .ToList();

        // If there are no non-MrWhite players, just return the list (can't enforce position)
        if (!nonMrWhitePlayers.Any())
        {
            return mrWhitePlayers;
        }

        // Insert each MrWhite into a random position excluding index 0.
        foreach (var mr in mrWhitePlayers)
        {
            // allowed insertion indices: 1 .. nonMrWhitePlayers.Count (inclusive) so it can end up last
            var insertIndex = random.Next(1, nonMrWhitePlayers.Count + 1);
            nonMrWhitePlayers.Insert(insertIndex, mr);
        }

        return nonMrWhitePlayers;
    }

    // Players participating in the current round (active and in picking order)
    private List<GamePlayer> activeRoundPlayers = new();

    private async Task StartVoting()
    {
        StopDiscussionTimer();
        gamePhase = GamePhase.Voting;
        selectedVoteTarget = null;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectVoteTarget(string playerId)
    {
        selectedVoteTarget = playerId;
        StateHasChanged();
    }

    private async Task SubmitVote()
    {
        if (selectedVoteTarget != null)
        {
            var votedPlayer = players.FirstOrDefault(p => p.Id == selectedVoteTarget && p.IsActive);
            if (votedPlayer != null)
            {
                // Check if Mr. White was voted out
                if (votedPlayer.Role == GameConstants.PlayerRoles.MrWhite)
                {
                    votedOutMrWhite = votedPlayer;
                    gamePhase = GamePhase.MrWhiteGuess;
                    mrWhiteGuess = "";
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    // Eliminate and show role reveal card
                    votedPlayer.IsActive = false;
                    eliminatedPlayer = votedPlayer;
                    gamePhase = GamePhase.PlayerEliminated;
                    await VibrateAsync(80);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private async Task OnMrWhiteGuessKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitMrWhiteGuess();
        }
    }

    private async Task SubmitMrWhiteGuess()
    {
        if (string.IsNullOrWhiteSpace(mrWhiteGuess) || votedOutMrWhite == null || currentGameWordPair == null)
            return;

        var guess = mrWhiteGuess.Trim();
        var civilianWord = currentGameWordPair.Civilian;

        if (guess.Equals(civilianWord, StringComparison.OrdinalIgnoreCase))
        {
            // Mr. White guessed correctly - wins the round
            gameResult = new GameResultDTO
            {
                Winner = "Mr. White",
                Reason = $"Mr. White ({votedOutMrWhite.Name}) correctly guessed the civilian word: '{civilianWord}'!"
            };
            
            // Award 3 points to Mr. White
            votedOutMrWhite.Score += 3;

            gamePhase = GamePhase.Results;
            await VibrateAsync(200);
        }
        else
        {
            // Mr. White guessed wrong - show elimination phase
            gamePhase = GamePhase.MrWhiteEliminated;
            await VibrateAsync(80);
        }

        await InvokeAsync(StateHasChanged);
    }

    // Host-triggered manual override: used when Mr. White's typed guess didn't match the
    // civilian word exactly (typo, spelling, accent) but the table agrees it was correct.
    // Mirrors the correct-guess branch of SubmitMrWhiteGuess without re-checking the string.
    private async Task OverrideMrWhiteCorrectGuess()
    {
        if (votedOutMrWhite == null || currentGameWordPair == null) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Award the win to {votedOutMrWhite.Name} as Mr. White? This ends the round.");
        if (!confirmed) return;

        var civilianWord = currentGameWordPair.Civilian;
        gameResult = new GameResultDTO
        {
            Winner = "Mr. White",
            Reason = $"Mr. White ({votedOutMrWhite.Name}) guessed '{mrWhiteGuess}' — manually confirmed as the civilian word '{civilianWord}'!"
        };

        votedOutMrWhite.Score += 3;
        gamePhase = GamePhase.Results;

        if (gameState != null)
        {
            gameState.Status = GameStatus.Finished;
        }

        await VibrateAsync(200);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ContinueWithoutMrWhite()
    {
        if (votedOutMrWhite == null) return;

        // Mark Mr. White inactive for the remainder of this round
        votedOutMrWhite.IsActive = false;

        // Check if game should end (only 2 active players left, etc.)
    // Evaluate victory or continue
    await EvaluateVictoryOrContinueAsync();
    }

    private async Task StartNewWordRound()
    {
        await ContinueWithoutMrWhite();
    }

    private async Task ContinueAfterPlayerElimination()
    {
        await EvaluateVictoryOrContinueAsync();
    }

    // New unified victory evaluation method based on current active players
    private async Task EvaluateVictoryOrContinueAsync()
    {
        var activeCivilians = players.Count(p => p.IsActive && p.Role == GameConstants.PlayerRoles.Civilian);
        var activeUndercover = players.Count(p => p.IsActive && p.Role == GameConstants.PlayerRoles.Undercover);
        var activeMrWhite = players.Count(p => p.IsActive && p.Role == GameConstants.PlayerRoles.MrWhite);

        // Civilian victory: all Undercover and Mr. White eliminated
        if (activeUndercover == 0 && activeMrWhite == 0)
        {
            gameResult = new GameResultDTO
            {
                Winner = "Civilians",
                Reason = "All Undercover agents and Mr. White were eliminated!"
            };
            foreach (var civ in players.Where(p => p.Role == GameConstants.PlayerRoles.Civilian))
            {
                civ.Score++;
            }
            gamePhase = GamePhase.Results;
        }
        // Undercover victory: civs eliminated OR parity (non-civs >= civs)
        else if (activeCivilians == 0 || (activeUndercover + activeMrWhite) >= activeCivilians)
        {
            gameResult = new GameResultDTO
            {
                Winner = "Undercover",
                Reason = activeCivilians == 0 ? "All civilians eliminated!" : "Undercovers can no longer be outvoted (parity reached)."
            };
            foreach (var u in players.Where(p => p.Role == GameConstants.PlayerRoles.Undercover || p.Role == GameConstants.PlayerRoles.MrWhite))
            {
                if (u.IsActive) u.Score++;
            }
            gamePhase = GamePhase.Results;
        }
        else
        {
            // Continue game: next discussion round with remaining active players using same word pair
            selectedVoteTarget = null;
            votedOutMrWhite = null;
            mrWhiteGuess = "";
            eliminatedPlayer = null;
            EnterDiscussionPhase();
        }

        if (gamePhase == GamePhase.Results)
        {
            if (gameState != null)
            {
                gameState.Status = GameStatus.Finished;
            }
            await VibrateAsync(200);
        }

        await InvokeAsync(StateHasChanged);
    }

    // "New Game" discards all players and scores, so guard it behind a confirmation -
    // a stray tap shouldn't be able to wipe out an in-progress or just-finished game.
    private async Task ConfirmResetGame()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Start a new game? This clears all players and scores.");
        if (confirmed)
        {
            await ResetGame();
        }
    }

    private async Task ResetGame()
    {
        StopDiscussionTimer();
        gamePhase = GamePhase.Setup;
        setupStep = 1;
        gameState = null;
        gameResult = null;
        players.Clear();
        bulkPlayerNamesInput = "";
        availableCards.Clear();
        currentCardIndex = 0;
        currentPlayerRole = null;
        currentGameWordPair = null;
        hasRevealedRole = false;
        selectedVoteTarget = null;
        votedOutMrWhite = null;
        mrWhiteGuess = "";

        GenerateSuggestedNames();
        await InvokeAsync(StateHasChanged);
    }

    private async Task NextRound()
    {
        // Keep the same players and configuration, but start a new round
        StopDiscussionTimer();
        gamePhase = GamePhase.RoleAssignment;
        gameState = null;
        gameResult = null;
        availableCards.Clear();
        currentCardIndex = 0;
        currentPlayerRole = null;
        currentGameWordPair = null;
        hasRevealedRole = false;
        selectedVoteTarget = null;
        votedOutMrWhite = null;
        mrWhiteGuess = "";

        // Reset all players to have no role assignments for the new round
        // Also ensure any players who were marked inactive (e.g. eliminated Mr. White)
        // are reactivated for the new round.
        foreach (var player in players)
        {
            player.Role = "";
            player.IsActive = true;
        }
        
        // Start the new game with the same configuration
        await StartGame();
    }

    // Helper methods for original player count (used in setup UI)
    private int GetCivilianCount()
    {
        return GetCivilianCountForPlayerCount(playerCount);
    }

    private int GetUndercoverCount()
    {
        return GetUndercoverCountForPlayerCount(playerCount);
    }

    private int GetMisterWhiteCount()
    {
        return GetMisterWhiteCountForPlayerCount(playerCount);
    }

    // Helper methods for specific player count (used for role assignment)
    private int GetCivilianCountForPlayerCount(int count)
    {
        return count switch
        {
            3 => 2,  // 2 civilians, 1 undercover, 0 white
            4 => 2,  // 2 civilians, 1 undercover, 1 white
            5 => 3,  // 3 civilians, 1 undercover, 1 white
            6 => 3,  // 3 civilians, 2 undercover, 1 white
            7 => 4,  // 4 civilians, 2 undercover, 1 white
            8 => 4,  // 4 civilians, 2 undercover, 2 white
            9 => 5,  // 5 civilians, 2 undercover, 2 white
            10 => 5, // 5 civilians, 3 undercover, 2 white
            _ => Math.Max(1, count - GetUndercoverCountForPlayerCount(count) - GetMisterWhiteCountForPlayerCount(count))
        };
    }

    private int GetUndercoverCountForPlayerCount(int count)
    {
        return count switch
        {
            3 => 1,
            4 => 1,
            5 => 1,
            6 => 2,
            7 => 2,
            8 => 2,
            9 => 2,
            10 => 3,
            _ => 1
        };
    }

    private int GetMisterWhiteCountForPlayerCount(int count)
    {
        return count switch
        {
            3 => 0,
            4 => 1,
            5 => 1,
            6 => 1,
            7 => 1,
            8 => 2,
            9 => 2,
            10 => 2,
            _ => count >= 4 ? 1 : 0
        };
    }

    private string GetRoleDisplayName(string role)
    {
        return role switch
        {
            GameConstants.PlayerRoles.Civilian => "Civilian",
            GameConstants.PlayerRoles.Undercover => "Undercover Agent",
            GameConstants.PlayerRoles.MrWhite => "Mr. White",
            _ => "Unknown"
        };
    }

    // Methods for current role distribution display
    private int GetCurrentCivilianCount()
    {
        if (useCustomRoles)
        {
            return playerCount - customUndercoverCount - customMrWhiteCount;
        }
        return GetCivilianCount();
    }

    private int GetCurrentUndercoverCount()
    {
        return useCustomRoles ? customUndercoverCount : GetUndercoverCount();
    }

    private int GetCurrentMrWhiteCount()
    {
        return useCustomRoles ? customMrWhiteCount : GetMisterWhiteCount();
    }

    // Validation methods for custom role configuration
    private bool IsRoleDistributionValid()
    {
        if (!useCustomRoles) return true;
        
        var totalNonCivilians = customUndercoverCount + customMrWhiteCount;
        var maxNonCivilians = playerCount / 2;
        
        return totalNonCivilians <= maxNonCivilians && 
               totalNonCivilians >= 0 && 
               customUndercoverCount >= 0 && 
               customMrWhiteCount >= 0;
    }

    private int GetMaxUndercoverCount()
    {
        var maxNonCivilians = playerCount / 2;
        return Math.Max(0, maxNonCivilians - customMrWhiteCount);
    }

    private int GetMaxMrWhiteCount()
    {
        var maxNonCivilians = playerCount / 2;
        return Math.Max(0, maxNonCivilians - customUndercoverCount);
    }

    // Stepper controls for the custom role counts - easier to tap precisely on mobile
    // than dragging a range slider across a 0-5-ish span.
    private void IncrementUndercoverCount()
    {
        if (customUndercoverCount < GetMaxUndercoverCount()) customUndercoverCount++;
    }

    private void DecrementUndercoverCount()
    {
        if (customUndercoverCount > 0) customUndercoverCount--;
    }

    private void IncrementMrWhiteCount()
    {
        if (customMrWhiteCount < GetMaxMrWhiteCount()) customMrWhiteCount++;
    }

    private void DecrementMrWhiteCount()
    {
        if (customMrWhiteCount > 0) customMrWhiteCount--;
    }

    private string FormatTime(int seconds)
    {
        var minutes = seconds / 60;
        var remainingSeconds = seconds % 60;
        return $"{minutes:D2}:{remainingSeconds:D2}";
    }

    // Setup wizard navigation (splits what used to be one long scrolling form into two steps)
    private bool CanProceedToPlayersStep()
    {
        return !string.IsNullOrEmpty(selectedCategoryName) && IsRoleDistributionValid();
    }

    private void GoToPlayersStep()
    {
        if (!CanProceedToPlayersStep()) return;
        setupStep = 2;
        StateHasChanged();
    }

    private void BackToSetupStep()
    {
        setupStep = 1;
        StateHasChanged();
    }

    public void Dispose()
    {
        StopDiscussionTimer();
    }
}
